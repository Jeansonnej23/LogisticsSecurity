                    { text: "Option B: Instruct warehouse operators to manually bypass AGVs and continue using paper picking sheets while IT investigates.", next: "paper_bypass" },
                    { text: "Option C: Attempt to remotely re-flash AGV firmware updates from the centralized admin dashboard.", next: "reflash" }
                ]
            },
            power_down: {
                title: "Network Isolated - Spread Halting",
                text: "Powering down the local subnet successfully prevented the malware from spreading across the corporate VPN to other regional distribution centers. However, 1,200 truck loads are now delayed at the gate.",
                choices: [
                    { text: "Option A: Perform forensic audit on OT subnet and deploy immutable offline backups.", next: "win_recovery" },
                    { text: "Option B: Turn network back on quickly after restarting server host nodes without deep audit.", next: "fail_reinfection" }
                ]
            },
            paper_bypass: {
                title: "Partial Continuity - Malware Spreading Upstream",
                text: "Paper picking allows dock workers to maintain 25% throughput, but because the infected network remained active, the ransomware accessed connected third-party 3PL carrier portals, sending corrupted dispatch notices globally.",
                choices: [
                    { text: "Option A: Sever all third-party API links immediately and isolate network.", next: "power_down" },
                    { text: "Option B: Contact external cyber incident response experts while leaving operations running.", next: "fail_catastrophe" }
                ]
            },
            reflash: {
                title: "Firmware Flash Blocked - Threat Elevated",
                text: "The attackers modified administrative credentials. Attempting to issue remote firmware commands inadvertently executed the attacker's payload, locking down the central database.",
                choices: [
                    { text: "Option A: Cut physical power to servers and initiate emergency air-gap response protocols.", next: "power_down" }
                ]
            },
            win_recovery: {
                title: "SUCCESSFUL RESILIENCE & CONTAINMENT",
                isEnd: true,
                success: true,
                text: "EXCELLENT DECISION MAKING. By immediately isolating the infected subnet and enforcing forensic air-gap audits, you limited operational downtime to 8 hours and prevented corporate-wide lateral infection. Your incident response plan saved an estimated $8.5M in potential damages."
            },
            fail_reinfection: {
                title: "CRITICAL FAILURE - RE-INFECTION TRIGGERED",
                isEnd: true,
                success: false,
                text: "FAILED RESPONSE. Restarting systems without purging the backdoor allowed attackers to execute secondary ransomware encryptions. All regional fulfillment centers were knocked offline for 5 days."
            },
            fail_catastrophe: {
                title: "CRITICAL FAILURE - GLOBAL SYSTEM CONTAGION",
                isEnd: true,
                success: false,
                text: "FAILED RESPONSE. Delaying network isolation caused malware contagion across 14 external logistics partners. Cyber insurance declined coverage due to gross negligence of protocol."
            }
        };

        let currentSimState = "start";

        function renderSimulator() {
            const simScreen = document.getElementById('simScreen');
            const state = simTree[currentSimState];

            if (state.isEnd) {
                simScreen.innerHTML = `
                    <div class="p-6 rounded-xl ${state.success ? 'bg-emerald-950/80 border border-emerald-500/40 text-emerald-100' : 'bg-rose-950/80 border border-rose-500/40 text-rose-100'} space-y-4">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid ${state.success ? 'fa-circle-check text-emerald-400' : 'fa-circle-xmark text-rose-400'} text-3xl"></i>
                            <h4 class="text-xl font-bold">${state.title}</h4>
                        </div>
                        <p class="text-sm leading-relaxed">${state.text}</p>
                        <button onclick="resetSimulator()" class="mt-4 px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-mono text-white transition-colors">
                            Try Another Strategy
                        </button>
                    </div>
                `;
            } else {
                let choicesHTML = state.choices.map(choice => `
                    <button onclick="makeSimChoice('${choice.next}')" class="w-full text-left p-4 rounded-xl bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-sm font-medium text-slate-200 transition-all hover:border-cyan-500/50 flex items-start gap-3">
                        <i class="fa-solid fa-chevron-right text-cyan-400 mt-1 shrink-0"></i>
                        <span>${choice.text}</span>
                    </button>
                `).join('');

                simScreen.innerHTML = `
                    <div class="space-y-4">
                        <h4 class="text-lg font-bold text-cyan-400 font-mono">${state.title}</h4>
                        <p class="text-sm text-slate-300 leading-relaxed">${state.text}</p>
                        <div class="pt-4 space-y-3">
                            ${choicesHTML}
                        </div>
                    </div>
                `;
            }
        }

        function makeSimChoice(nextState) {
            currentSimState = nextState;
            renderSimulator();
        }

        function resetSimulator() {
            currentSimState = "start";
            renderSimulator();
        }

        // Init Simulator
        renderSimulator();

        /* ----------------------------------------------------
           4. RISK CALCULATOR LOGIC
        ---------------------------------------------------- */
        function updateCalculator() {
            const vendorVal = parseInt(document.getElementById('vendorAuditRange').value);
            const otVal = parseInt(document.getElementById('otIsolationRange').value);
            const becVal = parseInt(document.getElementById('becAuthRange').value);

            // Update Text Displays
            document.getElementById('vendorVal').innerText = `${vendorVal}% Covered`;
            
            const otLabels = ["Flat IT/OT Network", "Partial Air-Gap", "Full Air-Gap"];
            document.getElementById('otVal').innerText = otLabels[otVal];

            document.getElementById('becVal').innerText = `${becVal}% Enforced`;

            // Calculate ALE (Annual Loss Expectation) - Baseline $5M
            let baseLoss = 5000000;
            baseLoss -= (vendorVal * 20000); // Up to -2.0M
            baseLoss -= (otVal * 1000000);  // Up to -2.0M
            baseLoss -= (becVal * 8000);    // Up to -0.8M

            if (baseLoss < 200000) baseLoss = 200000;

            document.getElementById('riskLossVal').innerText = `$${baseLoss.toLocaleString()}`;

            // Score Badge Logic
            const badge = document.getElementById('riskScoreBadge');
            if (baseLoss > 3000000) {
                badge.innerText = "HIGH RISK EXPOSURE";
                badge.className = "inline-block px-4 py-1.5 rounded-full text-xs font-mono font-bold mb-4 bg-rose-500/10 text-rose-500 border border-rose-500/30";
                document.getElementById('ransomFactor').innerText = "Critical";
                document.getElementById('becFactor').innerText = "Severe";
            } else if (baseLoss > 1200000) {
                badge.innerText = "MODERATE EXPOSURE";
                badge.className = "inline-block px-4 py-1.5 rounded-full text-xs font-mono font-bold mb-4 bg-amber-500/10 text-amber-500 border border-amber-500/30";
                document.getElementById('ransomFactor').innerText = "Medium";
                document.getElementById('becFactor').innerText = "Moderate";
            } else {
                badge.innerText = "LOW RISK / RESILIENT";
                badge.className = "inline-block px-4 py-1.5 rounded-full text-xs font-mono font-bold mb-4 bg-emerald-500/10 text-emerald-500 border border-emerald-500/30";
                document.getElementById('ransomFactor').innerText = "Low";
                document.getElementById('becFactor').innerText = "Mitigated";
            }
        }

        /* ----------------------------------------------------
           5. KNOWLEDGE QUIZ DATA & LOGIC
        ---------------------------------------------------- */
        const quizData = [
            {
                question: "1. Why are logistics enterprises frequently targeted as 'stepping-stone' vectors by cyber attackers?",
                options: [
                    "They possess no digital technology and rely solely on paper invoices.",
                    "They maintain interconnected systems with large clients while often having less stringent security controls.",
                    "Logistics networks are completely air-gapped from internet connections.",
                    "Shipment tracking codes contain financial credit card data."
                ],
                correct: 1,
                explanation: "Logistics providers often have shared EDI connections or system integration with large client networks, making them ideal entry points to breach higher-value corporate targets."
            },
            {
                question: "2. What is the primary operational mitigation against ransomware spreading from corporate IT into physical Port Terminal cranes (OT)?",
                options: [
                    "Installing anti-virus on legacy gantry cranes.",
                    "Network Segmentation and Purdue Model Air-Gapping between IT and OT networks.",
                    "Increasing truck gate processing fees.",
                    "Using public Wi-Fi networks for telemetry data."
                ],
                correct: 1,
                explanation: "Network segmentation prevents ransomware on corporate IT systems (like administrative email) from jumping to physical OT controllers."
            },
            {
                question: "3. Cryptographic firmware signing on warehouse IoT scanners prevents which type of weakness?",
                options: [
                    "Unauthorized loading of compromised, rogue device updates.",
                    "Physical battery failure on handheld devices.",
                    "GPS satellite positioning drift on delivery vans.",
                    "Email spear-phishing attacks against management."
                ],
                correct: 0,
                explanation: "Digital signatures ensure that handheld devices only accept authentic, verified firmware updates directly from the official manufacturer."
            },
            {
                question: "4. Which security control is most effective at preventing Business Email Compromise (BEC) freight routing fraud?",
                options: [
                    "Disabling all mobile phones in distribution centers.",
                    "Mandatory out-of-band verbal authorization and strict DMARC email enforcement.",
                    "Increasing the physical warehouse security guard staff.",
                    "Installing faster barcode scanners."
                ],
                correct: 1,
                explanation: "Dual-control out-of-band checks verify payment or routing changes via trusted phone channels, preventing fake email requests from executing."
            }
        ];

        let userAnswers = {};

        function renderQuiz() {
            const container = document.getElementById('quizContainer');
            container.innerHTML = quizData.map((q, qIndex) => `
                <div class="space-y-3 pb-6 border-b border-slate-100 dark:border-slate-700/60 last:border-0">
                    <p class="font-semibold text-slate-900 dark:text-white text-base">${q.question}</p>
                    <div class="space-y-2">
                        ${q.options.map((opt, oIndex) => `
                            <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                                <input type="radio" name="quiz_q_${qIndex}" value="${oIndex}" onchange="selectQuizOption(${qIndex}, ${oIndex})" class="mt-0.5 text-cyan-600 focus:ring-cyan-500">
                                <span>${opt}</span>
                            </label>
                        `).join('')}
                    </div>
                    <div id="quizExp_${qIndex}" class="hidden p-3 rounded-lg bg-slate-100 dark:bg-slate-900 text-xs text-slate-600 dark:text-slate-300"></div>
                </div>
            `).join('') + `
                <button onclick="submitQuiz()" class="w-full py-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-sm transition-colors">
                    Submit Knowledge Assessment
                </button>
            `;
        }

        function selectQuizOption(qIndex, oIndex) {
            userAnswers[qIndex] = oIndex;
        }

        function submitQuiz() {
            let score = 0;
            quizData.forEach((q, qIndex) => {
                const expEl = document.getElementById(`quizExp_${qIndex}`);
                expEl.classList.remove('hidden');
                
                if (userAnswers[qIndex] === q.correct) {
                    score++;
                    expEl.className = "p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-700 dark:text-emerald-300";
                    expEl.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> <strong>Correct!</strong> ${q.explanation}`;
                } else {
                    expEl.className = "p-3 rounded-lg bg-rose-500/10 border border-rose-500/30 text-xs text-rose-700 dark:text-rose-300";
                    expEl.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> <strong>Incorrect.</strong> ${q.explanation}`;
                }
            });

            // Summary
            const summary = document.getElementById('quizSummary');
            summary.classList.remove('hidden');
            document.getElementById('quizScoreText').innerText = `${score} / ${quizData.length}`;
            
            if (score === quizData.length) {
                document.getElementById('quizFeedbackText').innerText = "Outstanding! You have mastered key supply chain cybersecurity risks and defenses.";
            } else {
                document.getElementById('quizFeedbackText').innerText = "Good effort. Review the mitigation concepts above and re-try to boost your knowledge score.";
            }

            summary.scrollIntoView({ behavior: 'smooth' });
        }

        function resetQuiz() {
            userAnswers = {};
            document.getElementById('quizSummary').classList.add('hidden');
            renderQuiz();
        }

        // Init Quiz on load
        renderQuiz();
    </script>
</body>
